APP_ENV=local
DATABASE_URL=sqlite+aiosqlite:////app/data/legal_bot.db
DATABASE_STARTUP_WAIT_SECONDS=120

BOT_TOKEN=CHANGE_ME
RUN_BOT=false
RUN_SCHEDULER=true
TELEGRAM_DROP_PENDING_UPDATES=false
TELEGRAM_SINGLETON_WAIT_SECONDS=120
TELEGRAM_SINGLETON_RETRY_SECONDS=3
FSM_STORAGE_BACKEND=memory
REDIS_URL=redis://redis:6379/0
REDIS_STARTUP_WAIT_SECONDS=60

BOOTSTRAP_ADMIN=true
BOOTSTRAP_DEMO_DATA=true
REQUIRE_POSTGRES_IN_PRODUCTION=false
STARTUP_BACKUP_ENABLED=false

ADMIN_API_TOKEN=dev-admin-token

# Generate production secrets without local Python:
# bash ./generate-secrets.sh
SESSION_SIGNING_KEY_ID=session-v1
SESSION_SIGNING_KEY=
SESSION_SIGNING_PREVIOUS_KEYS=
SECURITY_HMAC_KEY_ID=hmac-v1
SECURITY_HMAC_KEY=
SECURITY_HMAC_PREVIOUS_KEYS=
MFA_ENCRYPTION_KEY_ID=mfa-v1
MFA_ENCRYPTION_KEY=
MFA_ENCRYPTION_PREVIOUS_KEYS=
AUDIT_INTEGRITY_KEY_ID=audit-v1
AUDIT_INTEGRITY_KEY=
AUDIT_INTEGRITY_PREVIOUS_KEYS=
DOCUMENT_ENCRYPTION_KEY_ID=documents-v1
DOCUMENT_ENCRYPTION_KEY=
DOCUMENT_ENCRYPTION_PREVIOUS_KEYS=
BACKUP_ENCRYPTION_KEY_ID=backups-v1
BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_PREVIOUS_KEYS=
ALLOW_LEGACY_SECURITY_KEY_FALLBACK=false

LEGAL_KEY_RATE=0.16
STORAGE_DIR=/app/storage
MAX_DOCUMENT_UPLOAD_MB=20
QUARANTINE_REJECTED_UPLOADS=true
UPLOAD_QUARANTINE_RETENTION_DAYS=7
# Local/test may keep the scanner disabled. Production preflight rejects this mode.
DOCUMENT_MALWARE_SCANNER=disabled
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=15
# DLC-INT-01: pikepdf validates/sanitises; OCR runs only when usable text is absent.
DOCUMENT_PDF_MIN_TEXT_BYTES=32
DOCUMENT_OCR_LANGUAGES=rus+eng
DOCUMENT_OCR_TIMEOUT_SECONDS=180
DOCUMENT_ACCESS_GRANT_TTL_SECONDS=180
DOCUMENT_ACCESS_MAX_ACTIVE_GRANTS=5

BACKUP_DIR=/app/backups
MAX_BACKUP_MB=2048
BACKUP_RETENTION_DAYS=30
BACKUP_READINESS_REQUIRED_IN_PRODUCTION=true
BACKUP_MAX_AGE_HOURS=26
AUTOMATIC_ENCRYPTED_BACKUPS_ENABLED=true
BACKUP_FRESHNESS_CACHE_SECONDS=300
BACKUP_FUTURE_CLOCK_SKEW_SECONDS=300

CLOSED_CASE_RETENTION_DAYS=1825
CASE_RETENTION_SCAN_BATCH_SIZE=100
CASE_RETENTION_EXECUTION_TIMEOUT_SECONDS=900
CASE_RETENTION_DRY_RUN=true

PAYMENT_WEBHOOK_SECRET=change-this-payment-secret
MAX_PAYMENT_WEBHOOK_KB=256
PAYMENT_WEBHOOK_PROCESSING_TIMEOUT_SECONDS=300
PAYMENT_WEBHOOK_MAX_ATTEMPTS=8

PUBLIC_BASE_URL=http://localhost:8000
TRUSTED_PROXY_CIDRS=
TRUSTED_PROXY_MAX_HOPS=5
TRUST_FORWARDED_PROTO=true

PAYMENT_PROVIDER=fake
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_COOKIE=dlc_admin_session
ALLOW_TOKEN_QUERY=true

DEMO_MODE=false
ENABLE_RECOVERY_ACTIONS=true
MIN_FREE_DISK_MB=500
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8000

# PM-027 self-filing package email delivery.
# Keep disabled until SMTP credentials are provisioned and acceptance-tested.
SELF_FILING_NEW_SALES_ENABLED=false
SELF_FILING_EMAIL_PROVIDER=disabled
SELF_FILING_SMTP_HOST=
SELF_FILING_SMTP_PORT=587
SELF_FILING_SMTP_USERNAME=
SELF_FILING_SMTP_PASSWORD=
SELF_FILING_SMTP_FROM_EMAIL=
SELF_FILING_SMTP_STARTTLS=true
SELF_FILING_EMAIL_MAX_ATTEMPTS=8
SELF_FILING_EMAIL_TIMEOUT_SECONDS=30
