APP_ENV=local
DATABASE_URL=sqlite+aiosqlite:///./legal_bot.db

# Telegram: обязательно заменить на токен от BotFather
BOT_TOKEN=CHANGE_ME
RUN_BOT=false

# Scheduler
RUN_SCHEDULER=true

# Admin API / admin-ui. Это отдельный credential для x-admin-token.
ADMIN_API_TOKEN=dev-admin-token

# Независимые ключи безопасности. Для production каждый secret должен быть
# уникальным и длиной не менее 32 случайных символов.
# Пример генерации: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SIGNING_KEY_ID=session-v1
SESSION_SIGNING_KEY=
SESSION_SIGNING_PREVIOUS_KEYS=
SECURITY_HMAC_KEY_ID=hmac-v1
SECURITY_HMAC_KEY=
SECURITY_HMAC_PREVIOUS_KEYS=
MFA_ENCRYPTION_KEY_ID=mfa-v1
MFA_ENCRYPTION_KEY=
MFA_ENCRYPTION_PREVIOUS_KEYS=
AUDIT_INTEGRITY_KEY_ID=audit-v1
AUDIT_INTEGRITY_KEY=
# Старые audit-ключи нельзя удалять, пока их события хранятся в журнале.
AUDIT_INTEGRITY_PREVIOUS_KEYS=
DOCUMENT_ENCRYPTION_KEY_ID=documents-v1
DOCUMENT_ENCRYPTION_KEY=
# Старый document key нельзя удалять, пока scheduler не перевёл все файлы
# на активный key id и Security Center не подтверждает отсутствие ошибок.
DOCUMENT_ENCRYPTION_PREVIOUS_KEYS=

# Включать только на короткий период перехода со старой версии, где
# ADMIN_API_TOKEN использовался для всех криптографических операций.
ALLOW_LEGACY_SECURITY_KEY_FALLBACK=false

# Legal calculator fallback key rate
LEGAL_KEY_RATE=0.16

# Storage and document upload security
STORAGE_DIR=./storage
MAX_DOCUMENT_UPLOAD_MB=20
QUARANTINE_REJECTED_UPLOADS=true
UPLOAD_QUARANTINE_RETENTION_DAYS=7
# Одноразовая выдача документов: фактический TTL ограничивается 30-300 секундами.
DOCUMENT_ACCESS_GRANT_TTL_SECONDS=180
# Максимум одновременно действующих разрешений на одну учётную запись.
DOCUMENT_ACCESS_MAX_ACTIVE_GRANTS=5

# Payments webhook. Для production заменить.
PAYMENT_WEBHOOK_SECRET=change-this-payment-secret

# Public URL backend. Для локального запуска оставить так.
PUBLIC_BASE_URL=http://localhost:8000

# Payments provider: fake for local/dev, yookassa for real payments
PAYMENT_PROVIDER=fake
# Для реальных платежей: PAYMENT_PROVIDER=yookassa и заполнить поля ниже
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Admin UI / browser auth
ADMIN_USERNAME=admin
# Set strong password for browser login. Token auth still works via x-admin-token.
ADMIN_PASSWORD=
ADMIN_SESSION_COOKIE=dlc_admin_session
ALLOW_TOKEN_QUERY=true

# v20 эксплуатация
DEMO_MODE=false
ENABLE_RECOVERY_ACTIONS=true
MIN_FREE_DISK_MB=500
BACKUP_DIR=./backups
