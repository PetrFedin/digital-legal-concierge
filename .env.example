APP_ENV=local
DATABASE_URL=sqlite+aiosqlite:///./legal_bot.db

# Telegram: обязательно заменить на токен от BotFather
BOT_TOKEN=CHANGE_ME
RUN_BOT=false

# Scheduler
RUN_SCHEDULER=true

# Admin API / admin-ui. Для production заменить.
ADMIN_API_TOKEN=dev-admin-token

# Legal calculator fallback key rate
LEGAL_KEY_RATE=0.16

# Storage
STORAGE_DIR=./storage

# Payments webhook. Для production заменить.
PAYMENT_WEBHOOK_SECRET=change-this-payment-secret

# Public URL backend. Для локального запуска оставить так.
PUBLIC_BASE_URL=http://localhost:8000

# Payments provider: fake for local/dev, yookassa for real payments
PAYMENT_PROVIDER=fake
# Для реальных платежей: PAYMENT_PROVIDER=yookassa и заполнить поля ниже
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Admin UI / browser auth
ADMIN_USERNAME=admin
# Set strong password for browser login. Token auth still works via x-admin-token.
ADMIN_PASSWORD=
ADMIN_SESSION_COOKIE=dlc_admin_session
ALLOW_TOKEN_QUERY=true

# v20 эксплуатация
DEMO_MODE=false
ENABLE_RECOVERY_ACTIONS=true
MIN_FREE_DISK_MB=500
BACKUP_DIR=./backups
