FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_CONSTRAINT=/app/constraints.txt \
    APP_ENV=test \
    DATABASE_URL=sqlite+aiosqlite:////tmp/legal_concierge_test.db \
    STORAGE_DIR=./storage \
    BACKUP_DIR=./backups

RUN apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client ca-certificates tesseract-ocr tesseract-ocr-rus \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml constraints.txt README.md alembic.ini ./
COPY Dockerfile Dockerfile.test docker-compose.yml docker-compose.timeweb.yml docker-compose.timeweb.split.yml ./
COPY .gitignore .dockerignore .env.example .env.production.example ./
COPY .github/workflows ./.github/workflows
COPY docker-entrypoint.sh run.sh check-and-run.sh bot-control.sh ./
COPY backup.sh restore.sh rollback.sh status.sh acceptance.sh test.sh ./
COPY deploy.sh timeweb-deploy.sh generate-secrets.sh ./
COPY migrations ./migrations
COPY app ./app
COPY scripts ./scripts
COPY content ./content
COPY docs ./docs
COPY tests ./tests

RUN pip install --upgrade pip \
    && pip install ".[test]" \
    && mkdir -p /app/storage /app/backups

CMD ["sh", "-c", "python scripts/init_db.py && pytest -q"]
